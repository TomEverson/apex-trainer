{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["@cloudflare/workers-types", "vite/client"]
  },
  "include": ["src", "worker-configuration.d.ts", "vite.config.ts", "kysely-types.ts", "scripts"]
}
