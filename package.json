{
  "name": "aim-trainer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply aim-trainer --local",
    "db:migrate:prod": "wrangler d1 migrations apply aim-trainer --remote",
    "db:status:local": "wrangler d1 migrations list aim-trainer --local",
    "db:types": "tsx scripts/codegen-runner.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ulidx": "^2.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "~7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.2.4",
    "wrangler": "4.110.0"
  }
}
